# Copy to .env and fill in real values. Never commit .env.

# TMDB API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# MySQL (used by docker compose to create the database and app user)
MYSQL_DATABASE=movies
MYSQL_USER=movie_app
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-another-strong-password

# Local run outside Docker (go run ./cmd/web) reads DB_DSN directly.
# DB_DSN=movie_app:change-me-strong-password@tcp(localhost:3306)/movies?parseTime=true

# Port published by docker-compose.yml for local use.
APP_PORT=4000

# Production on HestiaCP uses deploy/hestia/.env.example instead.
