{{define "nav"}}
<header class="site-header">
<a class="brand" href="/" aria-label="MovieClub TH home">Movie<span>Club</span> TH<span class="brand-dot">.</span></a>
<nav class="navigation" aria-label="Main navigation"><a href="/">Home</a><a href="/movies/">Movies</a><a href="/#actors">People</a><a href="#about">About</a>{{if .IsAdmin}}<a href="/movies/add">Admin</a>{{end}}</nav>
<div class="account">
