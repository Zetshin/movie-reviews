{{define "nav"}}
  <header class="site-header">
    <a class="brand" href="/" aria-label="MovieClub TH home">Movie<span>Club</span> TH<span class="brand-dot">.</span></a>
    <nav class="navigation" aria-label="Main navigation"><a href="/">Discover</a><a href="/movies/">Movies</a><a href="/actors/">Actors</a><a href="/#about">About</a></nav>
    <div class="search" data-movie-search>
      <span aria-hidden="true">⌕</span>
      <input type="search" role="combobox" aria-label="Search movies and actors" aria-autocomplete="list" aria-expanded="false" aria-controls="movie-search-results" placeholder="Search movies and actors" maxlength="100" autocomplete="off">
      <div class="search-dropdown" hidden><p class="search-status" role="status" aria-live="polite"></p><ul id="movie-search-results" role="listbox"></ul></div>
    </div>
    <div class="account">
      {{if .IsAuthenticated}}<a class="account-avatar" href="/profile" aria-label="Your profile">{{if .User.AvatarImage}}<img src="{{.User.AvatarImage}}" alt="">{{else}}<span aria-hidden="true">♙</span>{{end}}</a><form action="/user/logout" method="POST"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button class="button subtle" type="submit">Logout</button></form>{{if .IsAdmin}}<a class="button gold compact" href="/movies/add">Admin</a>{{end}}
      {{else}}<a class="sign-in" href="/user/login">Login</a><a class="button gold compact" href="/user/signup">Sign up <span aria-hidden="true">↗</span></a>{{end}}
    </div>
  </header>
{{end}}
