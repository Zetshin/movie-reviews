{{define "title"}}Signup{{end}}
{{define "main"}}
<h2>Join the club.</h2>
<p class='muted'>Discover films and share what you think.</p>
<form action='/user/signup' method='POST' novalidate>
<input type='hidden' name='csrf_token' value='{{.CSRFToken}}'>
    <div>
        <label for="signup-name">Name</label>
        {{with .Form.FieldErrors.name}}
            <label class='error'>{{.}}</label>
        {{end}}
        <input type='text' id='signup-name' autocomplete='name' name='name' value='{{.Form.Name}}'>
    </div>
    <div>
        <label for="signup-email">Email</label>
        {{with .Form.FieldErrors.email}}
            <label class='error'>{{.}}</label>
        {{end}}
        <input type='email' id='signup-email' autocomplete='email' name='email' value='{{.Form.Email}}'>
    </div>
    <div>
        <label for="signup-password">Password</label>
        {{with .Form.FieldErrors.password}}
            <label class='error'>{{.}}</label>
        {{end}}
        <input type='password' id='signup-password' autocomplete='new-password' name='password'>
    </div>
    <div>
        <input type='submit' value='Signup'>
    </div>
</form>
{{end}}