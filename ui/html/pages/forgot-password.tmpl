{{define "title"}}Forgot password{{end}}
{{define "main"}}
<h2>Reset your password.</h2>
<p class="muted">Enter your account email. If it exists, we’ll send a secure reset link.</p>
<form action="/user/forgot-password" method="POST" novalidate>
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<div>
<label for="reset-email">Email</label>
{{with .Form.FieldErrors.email}}<label class="error">{{.}}</label>{{end}}
<input type="email" id="reset-email" name="email" autocomplete="email" value="{{.Form.Email}}">
</div>
<div><input type="submit" value="Send reset link"></div>
</form>
{{end}}
