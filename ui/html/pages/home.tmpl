{{define "title"}}Discover your next favorite film{{end}}

{{define "base"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{template "title" .}} · MovieClub TH</title>
  <link rel="stylesheet" href="/static/css/home.css">
  <link rel="icon" href="/static/img/favicon.ico">
  <script src="/static/js/home.js?v=actors-route-12" defer></script>
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  {{template "nav" .}}
  <main id="content">
    {{with .Flash}}<div class="flash">{{.}}</div>{{end}}
    {{template "main" .}}
  </main>
  <footer class="site-footer"><a class="brand" href="/">Movie<span>Club</span> TH.</a><p>A good film stays with you. Find your next one.</p><a class="text-link" href="#credits">Credits</a><span>© {{.CurrentYear}} MovieClub TH</span></footer>
  {{template "credits" .}}
</body>
</html>
{{end}}

{{define "main"}}
<section class="hero" aria-label="Featured movies" aria-roledescription="carousel">
  <div class="hero-slides">
    {{if .HeroMovies}}{{range $index, $movie := .HeroMovies}}{{if lt $index 5}}
    <article class="hero-slide" data-slide {{if ne $index 0}}hidden{{end}} aria-label="{{.Title}}">
      <div class="hero-art" aria-hidden="true">{{if .BackdropImage}}<img src="{{.BackdropImage}}" alt="" {{if ne $index 0}}loading="lazy"{{else}}fetchpriority="high"{{end}}>{{else}}<img src="/static/img/cinematic-landscape.svg" alt="">{{end}}</div>
      <div class="hero-copy"><p class="eyebrow"><span class="tiny-line"></span> POPULAR ON TMDB</p><h1>{{.Title}}</h1>
      <div class="hero-meta">{{if not .ReleaseDate.IsZero}}<span>{{.ReleaseDate.Format "2006"}}</span><span class="divider">/</span>{{end}}<span class="rating">★ {{if .AvgRating}}{{.AvgRating}}<small> / 5</small>{{else}}Not rated{{end}}</span>{{if .ReviewCount}}<span class="muted">{{.ReviewCount}} reviews</span>{{end}}</div>
      <p class="synopsis">{{if .Description}}{{.Description}}{{else}}Discover this film and see what other movie lovers think.{{end}}</p><a class="button gold" href="/movies/{{.ID}}">Explore the movie <span aria-hidden="true">↗</span></a></div>
    </article>{{end}}{{end}}
    {{else}}
    <article class="hero-slide" data-slide aria-label="No featured movies yet">
      <div class="hero-art" aria-hidden="true"><img src="/static/img/cinematic-landscape.svg" alt=""></div>
      <div class="hero-copy"><p class="eyebrow"><span class="tiny-line"></span> YOUR NEXT GREAT WATCH</p><h1>A new story<br>starts here.</h1><p class="synopsis">Popular movies with backdrop images will appear here once they are in our library.</p>{{if .IsAdmin}}<a class="button gold" href="/movies/add">Import a movie <span aria-hidden="true">↗</span></a>{{else}}<a class="button gold" href="/movies/">Browse movies <span aria-hidden="true">↗</span></a>{{end}}</div>
    </article>{{end}}
  </div>
  <div class="hero-bottom"><span class="hero-caption">STORIES WORTH YOUR TIME</span><div class="carousel-controls"><div class="slide-dots" aria-label="Choose featured movie"></div><button class="circle" type="button" data-carousel="previous" aria-label="Previous movie">←</button><button class="circle" type="button" data-carousel="next" aria-label="Next movie">→</button><button class="circle pause-button" type="button" data-carousel="pause" aria-label="Pause automatic slides">Ⅱ</button></div></div>
</section>

<div class="home-content">
<section class="movie-section" aria-labelledby="new-title">
  <div class="section-heading"><div><p class="eyebrow">FRESH ON THE SCREEN</p><h2 id="new-title">New movies<span class="gold-text">.</span></h2></div><a class="text-link" href="/movies/">Browse all movies <span aria-hidden="true">↗</span></a></div>
  <div class="movie-grid">
  {{if .Movies}}{{range $index, $movie := .Movies}}{{if lt $index 6}}<a class="movie-card" href="/movies/{{.ID}}"><div class="poster poster-{{$index}}">{{if .PosterImage}}<img src="{{.PosterImage}}" alt="{{.Title}} poster" loading="lazy">{{end}}<span class="poster-fallback" aria-hidden="true">MOVIE<br><b>CLUB TH</b></span><span class="poster-tag">NEW</span></div><div class="card-copy"><h3>{{.Title}}</h3><div class="card-meta"><span>{{if not .ReleaseDate.IsZero}}{{.ReleaseDate.Format "2006"}}{{else}}Film{{end}}</span><span class="rating">★ {{if .AvgRating}}{{.AvgRating}}{{else}}—{{end}}<small> / 5</small></span></div></div></a>{{end}}{{end}}
  {{else}}<p class="empty-state">No movies have been added yet.</p>{{end}}
  </div>
</section>

<section class="movie-section" aria-labelledby="picks-title">
  <div class="section-heading"><div><p class="eyebrow">LOVED BY THE COMMUNITY</p><h2 id="picks-title">Top picks<span class="gold-text">.</span></h2></div><span class="section-note">Good films. Great conversations.</span></div>
  <div class="picks-grid">
  {{if .TopPicks}}{{range $index, $pick := .TopPicks}}{{if lt $index 3}}<article class="pick-card"><div class="pick-top"><a class="pick-poster poster poster-{{$index}}" href="/movies/{{.Movie.ID}}" aria-label="View {{.Movie.Title}}">{{if .Movie.PosterImage}}<img src="{{.Movie.PosterImage}}" alt="{{.Movie.Title}} poster" loading="lazy">{{end}}<span class="poster-fallback" aria-hidden="true">MOVIE<br><b>CLUB TH</b></span></a><div><span class="pick-rank">0{{if eq $index 0}}1{{else if eq $index 1}}2{{else}}3{{end}} / COMMUNITY PICK</span><h3><a href="/movies/{{.Movie.ID}}">{{.Movie.Title}}</a></h3><p class="rating">★ {{.Movie.AvgRating}}<small> / 5</small></p><p class="muted small">{{.Movie.ReviewCount}} reviews</p></div></div><div class="review-preview">{{with .ReviewPreview}}{{if .IsSpoiler}}<details class="pick-spoiler"><summary><strong>⚠ Spoiler alert</strong><span>Click to reveal</span></summary><p class="review-quote">“{{.Review}}”</p></details>{{else}}<p class="review-quote">“{{.Review}}”</p>{{end}}<div class="review-author"><span class="review-author-person"><span class="review-author-avatar">{{if .AvatarImage}}<img src="{{.AvatarImage}}" alt="" loading="lazy">{{else}}<span aria-hidden="true">♙</span>{{end}}</span><strong>{{if .Username}}{{.Username}}{{else}}Community reviewer{{end}}</strong></span><span class="rating">★ {{.Rating}} / 5</span></div>{{else}}<p class="review-quote muted">No review preview available yet.</p>{{end}}</div></article>{{end}}{{end}}
  {{else}}<p class="empty-state">No community picks yet. Movies need an average rating above 4/5 to appear here.</p>{{end}}
  </div>
</section>

<section class="movie-section actors-section" id="actors" aria-labelledby="actors-title">
  <div class="section-heading"><div><p class="eyebrow">IN THE SPOTLIGHT THIS WEEK</p><h2 id="actors-title">Trending actors<span class="gold-text">.</span></h2></div><span class="section-note">Weekly TMDB trends · updated on import</span></div>
  <div class="actors-grid">{{if .Actors}}{{range $index, $person := .Actors}}{{if lt $index 6}}<a class="actor-card" href="/actors/{{.ID}}"><div class="actor-image">{{if .ProfileImage}}<img src="{{.ProfileImage}}" alt="{{.Name}}" loading="lazy">{{end}}<span aria-hidden="true">◎</span></div><h3>{{.Name}}</h3><p>View profile →</p></a>{{end}}{{end}}{{else}}<p class="empty-state">Trending actors have not been imported yet.</p>{{end}}</div>
</section>
<div class="closing-note"><span class="gold-text" aria-hidden="true">✦</span><p>Less scrolling. More great cinema.</p><a class="text-link" href="/movies/">Find your next watch ↗</a></div>
</div>
{{end}}
