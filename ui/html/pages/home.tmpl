{{define "title"}}Discover your next favorite film{{end}}

{{define "base"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{template "title" .}} · MovieClub TH</title>
  <link rel="stylesheet" href="/static/css/home.css">
  <link rel="icon" href="/static/img/favicon.ico">
  <script src="/static/js/home.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="site-header">
    <a class="brand" href="/" aria-label="MovieClub TH home">Movie<span>Club</span> TH<span class="brand-dot">.</span></a>
    <nav class="navigation" aria-label="Main navigation"><a class="active" href="/">Discover</a><a href="/movies/">Movies</a><a href="#actors">People</a></nav>
    <div class="search" data-movie-search>
      <span aria-hidden="true">⌕</span>
      <input type="search" role="combobox" aria-label="Search movies and people" aria-autocomplete="list" aria-expanded="false" aria-controls="movie-search-results" placeholder="Search movies and people" maxlength="100" autocomplete="off">
      <div class="search-dropdown" hidden><p class="search-status" role="status" aria-live="polite"></p><ul id="movie-search-results" role="listbox"></ul></div>
    </div>
    <div class="account">
      {{if .IsAuthenticated}}<a class="sign-in" href="/profile">Profile</a><form action="/user/logout" method="POST"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button class="button subtle" type="submit">Sign out</button></form>{{if .IsAdmin}}<a class="button gold compact" href="/movies/add">Add movie</a>{{end}}
      {{else}}<a class="sign-in" href="/user/login">Sign in</a><a class="button gold compact" href="/user/signup">Join the club <span aria-hidden="true">↗</span></a>{{end}}
    </div>
  </header>
  <main id="content">
    {{with .Flash}}<div class="flash">{{.}}</div>{{end}}
    {{template "main" .}}
  </main>
  <footer class="site-footer"><a class="brand" href="/">Movie<span>Club</span> TH.</a><p>A good film stays with you. Find your next one.</p><span>© {{.CurrentYear}} MovieClub TH</span></footer>
</body>
</html>
{{end}}

{{define "main"}}
<section class="hero" aria-label="Featured movies" aria-roledescription="carousel">
  <div class="hero-slides">
    {{if .Movies}}{{range $index, $movie := .Movies}}{{if lt $index 5}}
    <article class="hero-slide" data-slide {{if ne $index 0}}hidden{{end}} aria-label="{{.Title}}">
      <div class="hero-art" aria-hidden="true"><img src="/static/img/cinematic-landscape.svg" alt=""></div>
      <div class="hero-copy"><p class="eyebrow"><span class="tiny-line"></span> THE LATEST ADDITION</p><p class="art-note">Decorative illustration · not a movie backdrop</p><h1>{{.Title}}</h1>
      <div class="hero-meta">{{if not .ReleaseDate.IsZero}}<span>{{.ReleaseDate.Format "2006"}}</span><span class="divider">/</span>{{end}}<span class="rating">★ {{if .AvgRating}}{{.AvgRating}}<small> / 5</small>{{else}}Not rated{{end}}</span>{{if .ReviewCount}}<span class="muted">{{.ReviewCount}} reviews</span>{{end}}</div>
      <p class="synopsis">{{if .Description}}{{.Description}}{{else}}Discover this film and see what other movie lovers think.{{end}}</p><a class="button gold" href="/movies/{{.ID}}">Explore the movie <span aria-hidden="true">↗</span></a></div>
    </article>{{end}}{{end}}
    {{else}}
    <article class="hero-slide" data-slide aria-label="Sample featured movie">
      <div class="hero-art" aria-hidden="true"><img src="/static/img/cinematic-landscape.svg" alt=""></div>
      <div class="hero-copy"><p class="eyebrow"><span class="tiny-line"></span> A WORLD BEYOND THE FRAME</p><span class="sample-label">SAMPLE DATA · UI PREVIEW</span><h1>The Last<br>Horizon</h1><div class="hero-meta"><span>2024</span><span class="divider">/</span><span class="rating">★ 4.6<small> / 5</small></span><span class="muted">Sample rating</span></div><p class="synopsis">At the edge of everything we know, a new story begins. A journey into the unknown, and the things that make us human.</p><a class="button gold" href="/movies/">Discover movies <span aria-hidden="true">↗</span></a></div>
    </article>{{end}}
  </div>
  <div class="hero-bottom"><span class="hero-caption">STORIES WORTH YOUR TIME</span><div class="carousel-controls"><div class="slide-dots" aria-label="Choose featured movie"></div><button class="circle" type="button" data-carousel="previous" aria-label="Previous movie">←</button><button class="circle" type="button" data-carousel="next" aria-label="Next movie">→</button><button class="circle pause-button" type="button" data-carousel="pause" aria-label="Pause automatic slides">Ⅱ</button></div></div>
</section>

<div class="home-content">
<section class="movie-section" aria-labelledby="new-title">
  <div class="section-heading"><div><p class="eyebrow">FRESH ON THE SCREEN</p><h2 id="new-title">New movies<span class="gold-text">.</span></h2></div><a class="text-link" href="/movies/">Browse all movies <span aria-hidden="true">↗</span></a></div>
  {{if not .Movies}}<p class="sample-notice">Sample data · ตัวอย่างสำหรับดูดีไซน์ ยังไม่มีข้อมูลหนังส่งมาจาก backend</p>{{end}}
  <div class="movie-grid">
  {{if .Movies}}{{range $index, $movie := .Movies}}{{if lt $index 6}}<a class="movie-card" href="/movies/{{.ID}}"><div class="poster poster-{{$index}}">{{if .PosterImage}}<img src="{{.PosterImage}}" alt="{{.Title}} poster" loading="lazy">{{end}}<span class="poster-fallback" aria-hidden="true">MOVIE<br><b>CLUB TH</b></span><span class="poster-tag">NEW</span></div><div class="card-copy"><h3>{{.Title}}</h3><div class="card-meta"><span>{{if not .ReleaseDate.IsZero}}{{.ReleaseDate.Format "2006"}}{{else}}Film{{end}}</span><span class="rating">★ {{if .AvgRating}}{{.AvgRating}}{{else}}—{{end}}<small> / 5</small></span></div></div></a>{{end}}{{end}}
  {{else}}{{template "sample-movie" "Echoes of Tomorrow"}}{{template "sample-movie" "The Silent Divide"}}{{template "sample-movie" "Whispering Pines"}}{{template "sample-movie" "A Brighter Summer"}}{{template "sample-movie" "The Fallen Regiment"}}{{template "sample-movie" "Beneath the Surface"}}{{end}}
  </div>
</section>

<section class="movie-section" aria-labelledby="picks-title">
  <div class="section-heading"><div><p class="eyebrow">LOVED BY THE COMMUNITY</p><h2 id="picks-title">Top picks<span class="gold-text">.</span></h2></div><span class="section-note">Good films. Great conversations.</span></div>
  {{if not .TopPicks}}<p class="sample-notice">Sample data · ตัวอย่างการ์ดและรีวิว ยังไม่มีผล Top Picks ส่งมาจาก backend</p>{{end}}
  <div class="picks-grid">
  {{if .TopPicks}}{{range $index, $pick := .TopPicks}}{{if lt $index 3}}<article class="pick-card"><div class="pick-top"><a class="pick-poster poster poster-{{$index}}" href="/movies/{{.Movie.ID}}" aria-label="View {{.Movie.Title}}">{{if .Movie.PosterImage}}<img src="{{.Movie.PosterImage}}" alt="{{.Movie.Title}} poster" loading="lazy">{{end}}<span class="poster-fallback" aria-hidden="true">MOVIE<br><b>CLUB TH</b></span></a><div><span class="pick-rank">0{{if eq $index 0}}1{{else if eq $index 1}}2{{else}}3{{end}} / COMMUNITY PICK</span><h3><a href="/movies/{{.Movie.ID}}">{{.Movie.Title}}</a></h3><p class="rating">★ {{.Movie.AvgRating}}<small> / 5</small></p><p class="muted small">{{.Movie.ReviewCount}} reviews</p></div></div><div class="review-preview">{{with .ReviewPreview}}<p class="review-quote">“{{.Review}}”</p><div class="review-author"><span>{{if .Username}}{{.Username}}{{else}}Community reviewer{{end}}</span><span class="rating">★ {{.Rating}} / 5</span></div>{{else}}<p class="review-quote muted">No review preview available yet.</p>{{end}}</div></article>{{end}}{{end}}
  {{else}}{{template "sample-pick" "The Wandering Soul"}}{{template "sample-pick" "Celestial Divide"}}{{template "sample-pick" "When We Met Again"}}{{end}}
  </div>
</section>

<section class="movie-section actors-section" id="actors" aria-labelledby="actors-title">
  <div class="section-heading"><div><p class="eyebrow">THE PEOPLE BEHIND THE STORIES</p><h2 id="actors-title">People in the spotlight<span class="gold-text">.</span></h2></div><span class="section-note">Meet the faces of cinema</span></div>
  {{if not .Actors}}<p class="sample-notice">Sample data · รายชื่อบุคคลตัวอย่าง ยังไม่มีข้อมูลบุคคลส่งมาจาก backend</p>{{end}}
  <div class="actors-grid">{{if .Actors}}{{range $index, $person := .Actors}}{{if lt $index 6}}<a class="actor-card" href="/persons/{{.ID}}"><div class="actor-image">{{if .ProfileImage}}<img src="{{.ProfileImage}}" alt="{{.Name}}" loading="lazy">{{end}}<span aria-hidden="true">◎</span></div><h3>{{.Name}}</h3><p>View profile →</p></a>{{end}}{{end}}{{else}}{{template "sample-person" "Emily Carter"}}{{template "sample-person" "Daniel Brooks"}}{{template "sample-person" "Sophia Lin"}}{{template "sample-person" "Marcus Reed"}}{{template "sample-person" "Olivia Hayes"}}{{template "sample-person" "Adrian Cole"}}{{end}}</div>
</section>
<div class="closing-note"><span class="gold-text" aria-hidden="true">✦</span><p>Less scrolling. More great cinema.</p><a class="text-link" href="/movies/">Find your next watch ↗</a></div>
</div>
{{end}}

{{define "sample-movie"}}<article class="movie-card sample-card"><div class="poster"><span class="poster-fallback sample-title">{{.}}</span><span class="poster-tag">SAMPLE</span></div><div class="card-copy"><h3>{{.}}</h3><div class="card-meta"><span>2024 · Sample</span><span class="rating">★ 4.2<small> / 5</small></span></div></div></article>{{end}}
{{define "sample-pick"}}<article class="pick-card"><div class="pick-top"><div class="pick-poster poster"><span class="poster-fallback sample-title">{{.}}</span></div><div><span class="pick-rank">SAMPLE COMMUNITY PICK</span><h3>{{.}}</h3><p class="rating">★ 4.7<small> / 5</small></p><p class="muted small">12 sample reviews</p></div></div><div class="review-preview"><p class="review-quote">“Beautifully told. The kind of film that stays with you long after the credits.”</p><div class="review-author"><span>Sample reviewer</span><span class="rating">★ 5 / 5</span></div></div></article>{{end}}
{{define "sample-person"}}<article class="actor-card"><div class="actor-image"><span aria-hidden="true">◎</span></div><h3>{{.}}</h3><p>Sample person</p></article>{{end}}
