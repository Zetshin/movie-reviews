{{define "title"}}Login{{end}}
{{define "main"}}
<h2>Welcome back.</h2>
<p class='muted'>Sign in to share your next review.</p>
<form action='/user/login' method='POST' novalidate>
<input type='hidden' name='csrf_token' value='{{.CSRFToken}}'>
    <!-- Notice that here we are looping over the NonFieldErrors and displaying
    them, if any exist -->
    {{range .Form.NonFieldErrors}}
        <div class='error'>{{.}}</div>
    {{end}}
    <div>
        <label for="login-email">Email</label>
        {{with .Form.FieldErrors.email}}
            <label class='error'>{{.}}</label>
        {{end}}
        <input type='email' id='login-email' autocomplete='email' name='email' value='{{.Form.Email}}'>
    </div>
    <div>
        <label for="login-password">Password</label>
        {{with .Form.FieldErrors.password}}
            <label class='error'>{{.}}</label>
        {{end}}
        <input type='password' id='login-password' autocomplete='current-password' name='password'>
    </div>
    <div>
        <input type='submit' value='Login'>
    </div>
</form>
<p><a class="text-link" href="/user/forgot-password">Forgot your password?</a></p>
{{end}}
