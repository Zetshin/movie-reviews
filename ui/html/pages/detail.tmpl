{{define "title"}}{{.Movie.Title}}{{end}}
{{define "main"}}
<p class="breadcrumb"><a href="/movies/">← All movies</a></p>
{{with .Movie}}
<section class="movie-detail has-admin-actions">
{{if and $.IsAuthenticated $.IsAdmin}}
<details class="admin-actions"><summary aria-label="Manage movie">&#8943;</summary><div class="admin-dropdown"><a href="/movies/{{.ID}}/edit">Edit movie</a><a class="danger-link" href="/movies/{{.ID}}/delete">Delete movie</a></div></details>
{{end}}
<div class="poster detail-poster"><span class="poster-fallback">MOVIE<br><b>CLUB TH</b></span>{{if .PosterImage}}<img src="{{.PosterImage}}" alt="{{.Title}} poster">{{end}}</div>
<div><p class="eyebrow">THE MOVIE</p><h1>{{.Title}}</h1><div class="detail-meta"><span>{{if not .ReleaseDate.IsZero}}{{.ReleaseDate.Format "2006"}}{{else}}Year unavailable{{end}}</span><span class="rating">★ {{.AvgRating}} <small>/ 5</small></span><span class="muted">{{.ReviewCount}} reviews</span></div><h2>Synopsis</h2><p class="description">{{if .Description}}{{.Description}}{{else}}No synopsis available yet.{{end}}</p><a class="button gold" href="/movies/{{.ID}}/review">Write a review</a></div>
</section>
<section class="cast-section" aria-labelledby="cast-title">
<div class="section-heading"><h2 id="cast-title">Cast &amp; credits.</h2></div>
<div class="cast-carousel" data-cast-carousel>
<button class="cast-arrow cast-arrow-previous" type="button" data-cast-direction="-1" aria-label="Previous cast members" aria-controls="movie-cast" hidden><span aria-hidden="true">&#8249;</span></button>
<div id="movie-cast" class="cast-grid" tabindex="0" role="region" aria-label="Cast and credits, scroll horizontally">
{{range $.Cast}}
<a class="actor-card cast-card" href="/actors/{{.ID}}?from_movie={{$.Movie.ID}}">
<div class="actor-image">{{if .ProfileImage}}<img src="{{.ProfileImage}}" alt="{{.Name}}" loading="lazy">{{end}}<span aria-hidden="true">&#9733;</span></div>
<h3>{{.Name}}</h3>{{if .CharacterName}}<p class="cast-character">{{.CharacterName}}</p>{{else}}<p class="cast-character muted">Character unavailable</p>{{end}}
</a>
{{else}}<p class="empty-state">No cast information available yet.</p>{{end}}
</div>
<button class="cast-arrow cast-arrow-next" type="button" data-cast-direction="1" aria-label="Next cast members" aria-controls="movie-cast" hidden><span aria-hidden="true">&#8250;</span></button>
</div>
</section>
<section id="reviews" class="reviews-section">
<div class="section-heading"><h2>Community reviews.</h2><form class="review-sort" method="GET" action="/movies/{{.ID}}#reviews"><label for="review-sort">Sort by</label><select id="review-sort" name="sort"><option value="latest" {{if ne $.Pagination.Sort "popular"}}selected{{end}}>Latest</option><option value="popular" {{if eq $.Pagination.Sort "popular"}}selected{{end}}>Most liked</option></select><noscript><button class="button subtle compact">Apply</button></noscript></form></div>
<div class="reviews-list">{{range $.Reviews}}<article class="review-card"><div class="review-header"><div class="review-user"><span class="review-avatar">{{if .AvatarImage}}<img src="{{.AvatarImage}}" alt="{{.Username}} profile photo" loading="lazy">{{else}}<span aria-hidden="true">♙</span>{{end}}</span><div><strong class="review-username">{{.Username}}</strong><time class="muted" datetime="{{.CreatedAt.Format "2006-01-02T15:04:05Z07:00"}}">{{humanDate .CreatedAt}}</time></div></div><span class="rating">★ {{.Rating}} / 5</span></div>{{if .IsSpoiler}}<details class="spoiler-review"><summary><strong>⚠ Spoiler alert</strong><span>Click to reveal this review</span></summary><p class="description">{{.Review}}</p></details>{{else}}<p class="description">{{.Review}}</p>{{end}}<p class="muted review-likes">{{.LikeCount}} likes</p></article>{{else}}<p class="empty-state">No reviews yet. Be the first to share your thoughts.</p>{{end}}</div>
{{if gt $.Pagination.TotalPages 0}}<nav class="pagination" aria-label="Review pages">{{if gt $.Pagination.Page 1}}<a class="button subtle compact" href="?page={{$.Pagination.PreviousPage}}&amp;sort={{$.Pagination.Sort}}#reviews">← Previous</a>{{end}}{{template "page-links" (pageLinks $.Pagination.Page $.Pagination.TotalPages $.PageURL "reviews")}}{{if lt $.Pagination.Page $.Pagination.TotalPages}}<a class="button subtle compact" href="?page={{$.Pagination.NextPage}}&amp;sort={{$.Pagination.Sort}}#reviews">Next →</a>{{end}}</nav>{{end}}
</section>
{{end}}
{{end}}
