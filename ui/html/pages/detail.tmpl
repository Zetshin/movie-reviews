{{define "title"}}{{.Movie.Title}}{{end}}
{{define "main"}}
<p class="breadcrumb"><a href="/movies/">← All movies</a></p>
{{with .Movie}}
<section class="movie-detail">
<div class="poster detail-poster"><span class="poster-fallback">MOVIE<br><b>CLUB TH</b></span>{{if .PosterImage}}<img src="{{.PosterImage}}" alt="{{.Title}} poster">{{end}}</div>
<div><p class="eyebrow">THE MOVIE</p><h1>{{.Title}}</h1><div class="detail-meta"><span>{{if not .ReleaseDate.IsZero}}{{.ReleaseDate.Format "2006"}}{{else}}Year unavailable{{end}}</span><span class="rating">★ {{.AvgRating}} <small>/ 5</small></span><span class="muted">{{.ReviewCount}} reviews</span></div><h2>Synopsis</h2><p class="description">{{if .Description}}{{.Description}}{{else}}No synopsis available yet.{{end}}</p><a class="button gold" href="/movies/{{.ID}}/review">Write a review</a></div>
</section>
<section id="reviews" class="reviews-section">
<div class="section-heading"><h2>Community reviews.</h2><form class="review-sort" method="GET" action="/movies/{{.ID}}#reviews"><label for="review-sort">Sort by</label><select id="review-sort" name="sort"><option value="latest" {{if ne $.Pagination.Sort "popular"}}selected{{end}}>Latest</option><option value="popular" {{if eq $.Pagination.Sort "popular"}}selected{{end}}>Most liked</option></select><noscript><button class="button subtle compact">Apply</button></noscript></form></div>
<div class="reviews-list">{{range $.Reviews}}<article class="review-card"><div class="review-header"><span class="rating">★ {{.Rating}} / 5</span><time class="muted">{{humanDate .CreatedAt}}</time></div>{{if .Username}}<p class="review-by">By {{.Username}}</p>{{end}}<p class="description">{{.Review}}</p><p class="muted review-likes">{{.LikeCount}} likes</p></article>{{else}}<p class="empty-state">No reviews yet. Be the first to share your thoughts.</p>{{end}}</div>
{{if gt $.Pagination.TotalPages 0}}<nav class="pagination" aria-label="Review pages">{{if gt $.Pagination.Page 1}}<a class="button subtle compact" href="?page={{$.Pagination.PreviousPage}}&amp;sort={{$.Pagination.Sort}}#reviews">← Previous</a>{{end}}<span>Page {{$.Pagination.Page}} of {{$.Pagination.TotalPages}}</span>{{if lt $.Pagination.Page $.Pagination.TotalPages}}<a class="button subtle compact" href="?page={{$.Pagination.NextPage}}&amp;sort={{$.Pagination.Sort}}#reviews">Next →</a>{{end}}</nav>{{end}}
</section>
{{end}}
{{end}}
