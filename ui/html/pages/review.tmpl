{{define "title"}}{{if .EditingReviewID}}Edit review: {{else}}Review {{end}}{{.Movie.Title}}{{end}}
{{define "main"}}
<p class="breadcrumb"><a href="/movies/{{.Movie.ID}}#reviews">← Back to movie</a></p>
<section class="review-intro"><p class="eyebrow">YOUR TAKE, YOUR RATING</p><h1>{{if .EditingReviewID}}Update your review.{{else}}What stayed with you?{{end}}</h1><p class="muted">Share your thoughts on <strong>{{.Movie.Title}}</strong>.</p></section>
<form class="review-editor" action="{{if .EditingReviewID}}/reviews/{{.EditingReviewID}}/edit{{else}}/movies/{{.Movie.ID}}/review{{end}}" method="POST">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<fieldset class="rating-field" {{with .Form.FieldErrors.rating}}aria-describedby="rating-error"{{end}}>
<legend>Your rating</legend><p class="rating-hint">Choose from 0.5 to 5 stars. Select the left or right half of a star.</p>
{{with .Form.FieldErrors.rating}}<p class="error" id="rating-error">{{.}}</p>{{end}}
<div class="star-picker">
<input id="star-10" type="radio" name="rating" value="5.0" required {{if eq .Form.Rating 5.0}}checked{{end}}><label class="half-right" for="star-10"><span aria-hidden="true">★</span><span class="visually-hidden">5.0 out of 5 stars</span></label>
<input id="star-9" type="radio" name="rating" value="4.5" {{if eq .Form.Rating 4.5}}checked{{end}}><label class="half-left" for="star-9"><span aria-hidden="true">★</span><span class="visually-hidden">4.5 out of 5 stars</span></label>
<input id="star-8" type="radio" name="rating" value="4.0" {{if eq .Form.Rating 4.0}}checked{{end}}><label class="half-right" for="star-8"><span aria-hidden="true">★</span><span class="visually-hidden">4.0 out of 5 stars</span></label>
<input id="star-7" type="radio" name="rating" value="3.5" {{if eq .Form.Rating 3.5}}checked{{end}}><label class="half-left" for="star-7"><span aria-hidden="true">★</span><span class="visually-hidden">3.5 out of 5 stars</span></label>
<input id="star-6" type="radio" name="rating" value="3.0" {{if eq .Form.Rating 3.0}}checked{{end}}><label class="half-right" for="star-6"><span aria-hidden="true">★</span><span class="visually-hidden">3.0 out of 5 stars</span></label>
<input id="star-5" type="radio" name="rating" value="2.5" {{if eq .Form.Rating 2.5}}checked{{end}}><label class="half-left" for="star-5"><span aria-hidden="true">★</span><span class="visually-hidden">2.5 out of 5 stars</span></label>
<input id="star-4" type="radio" name="rating" value="2.0" {{if eq .Form.Rating 2.0}}checked{{end}}><label class="half-right" for="star-4"><span aria-hidden="true">★</span><span class="visually-hidden">2.0 out of 5 stars</span></label>
<input id="star-3" type="radio" name="rating" value="1.5" {{if eq .Form.Rating 1.5}}checked{{end}}><label class="half-left" for="star-3"><span aria-hidden="true">★</span><span class="visually-hidden">1.5 out of 5 stars</span></label>
<input id="star-2" type="radio" name="rating" value="1.0" {{if eq .Form.Rating 1.0}}checked{{end}}><label class="half-right" for="star-2"><span aria-hidden="true">★</span><span class="visually-hidden">1.0 out of 5 stars</span></label>
<input id="star-1" type="radio" name="rating" value="0.5" {{if eq .Form.Rating 0.5}}checked{{end}}><label class="half-left" for="star-1"><span aria-hidden="true">★</span><span class="visually-hidden">0.5 out of 5 stars</span></label>
</div>
<p class="selected-rating" aria-live="polite">{{if .Form.Rating}}{{.Form.Rating}} / 5 stars{{else}}No rating selected{{end}}</p>
</fieldset>
<div><label for="review-text">Your review</label><p class="editor-hint" id="review-hint">What worked for you? What didn't?</p>
{{with .Form.FieldErrors.review_text}}<p class="error" id="review-error">{{.}}</p>{{end}}
<textarea id="review-text" name="review_text" maxlength="2000" required placeholder="The scene I keep thinking about…" aria-describedby="review-hint{{with .Form.FieldErrors.review_text}} review-error{{end}}" {{with .Form.FieldErrors.review_text}}aria-invalid="true"{{end}}>{{.Form.ReviewText}}</textarea>
<p>Up to 2000 characters.</p></div>
<label class="spoiler-toggle" for="is-spoiler"><input id="is-spoiler" type="checkbox" name="is_spoiler" value="true" {{if .Form.IsSpoiler}}checked{{end}}><span><strong>This review contains spoilers</strong><small>Readers will need to reveal the review before they can read it.</small></span></label>
<div class="editor-actions"><a class="button subtle" href="{{if .EditingReviewID}}/profile{{else}}/movies/{{.Movie.ID}}#reviews{{end}}">Cancel</a><button class="button gold" type="submit">{{if .EditingReviewID}}Save changes{{else}}Publish review ↗{{end}}</button></div>
</form>
{{end}}
