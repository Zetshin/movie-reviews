{{define "title"}}Your profile{{end}}
{{define "main"}}
<section class="profile-card">
<button class="profile-avatar avatar-trigger" type="button" data-avatar-trigger aria-label="Upload a new profile photo" aria-describedby="avatar-hint" hidden>{{if .User.AvatarImage}}<img src="{{.User.AvatarImage}}" alt="Your profile photo">{{else}}<span aria-hidden="true">♙</span>{{end}}<span class="avatar-overlay" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 16V3m-5 5 5-5 5 5M4 15v5h16v-5"/></svg><span>Upload photo</span></span></button>
<noscript><div class="profile-avatar">{{if .User.AvatarImage}}<img src="{{.User.AvatarImage}}" alt="Your profile photo">{{else}}<span aria-hidden="true">♙</span>{{end}}</div></noscript>
<p class="eyebrow">YOUR ACCOUNT</p>
<h1>Your profile.</h1>
<p class="muted">Your place in the MovieClub TH community.</p>
{{with .User}}<dl><dt>Name</dt><dd>{{.Name}}</dd><dt>Email</dt><dd>{{.Email}}</dd><dt>Member since</dt><dd>{{humanDate .Created}}</dd></dl>{{end}}
<form class="avatar-form" action="/profile/avatar" method="POST" enctype="multipart/form-data">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<p class="muted" id="avatar-hint">Tap your photo to upload. JPG or PNG, up to 2 MB.</p>
{{with .AvatarError}}<p class="error" role="alert">{{.}}</p>{{end}}
<p class="error" data-avatar-error role="alert" hidden></p>
<div class="avatar-fallback">
<label for="avatar-file">Choose a profile photo</label>
<input type="file" id="avatar-file" name="avatar" accept="image/jpeg,image/png" aria-describedby="avatar-hint" required>
<button class="button gold compact" type="submit">Save photo</button>
</div>
</form>
<a class="button gold" href="/movies/">Discover movies →</a>
</section>
<dialog class="avatar-dialog" aria-labelledby="avatar-dialog-title">
<div class="avatar-dialog-heading"><h2 id="avatar-dialog-title">Adjust your photo</h2><button type="button" class="button subtle compact" data-avatar-cancel aria-label="Close photo editor">✕</button></div>
<p class="muted" id="avatar-crop-hint">Drag to reposition. Use the slider to zoom, or arrow keys to move the photo.</p>
<div class="avatar-crop-stage"><canvas width="512" height="512" tabindex="0" aria-label="Profile photo crop preview" aria-describedby="avatar-crop-hint"></canvas><div class="avatar-crop-mask" aria-hidden="true"></div></div>
<label for="avatar-zoom">Zoom</label><div class="avatar-zoom-controls"><button type="button" data-avatar-zoom="out" aria-label="Zoom out">−</button><input id="avatar-zoom" type="range" min="1" max="3" step="0.01" value="1"><button type="button" data-avatar-zoom="in" aria-label="Zoom in">+</button></div>
<p class="error" data-avatar-dialog-error role="alert" hidden></p>
<div class="avatar-dialog-actions"><button class="button subtle compact" type="button" data-avatar-cancel>Cancel</button><button class="button gold compact" type="button" data-avatar-save>Save photo</button></div>
</dialog>
<section class="profile-reviews" aria-labelledby="your-reviews-title">
<div class="section-heading"><h2 id="your-reviews-title">Your reviews.</h2><span class="muted">{{len .UserReviews}} reviews</span></div>
<div class="reviews-list">{{range .UserReviews}}
<article class="review-card profile-review" id="review-{{.ID}}">
<a class="poster profile-review-poster" href="/movies/{{.MovieID}}">{{if .PosterImage}}<img src="{{.PosterImage}}" alt="Poster for {{.MovieTitle}}" loading="lazy">{{end}}<span class="poster-fallback" aria-hidden="true">MOVIE</span></a>
<div class="profile-review-copy"><div class="review-header"><h3><a href="/movies/{{.MovieID}}">{{.MovieTitle}}</a></h3><span class="rating">★ {{.Rating}} / 5</span></div><p class="muted small">Reviewed {{humanDate .CreatedAt}}{{if .IsSpoiler}} · <span class="spoiler-badge">Spoiler</span>{{end}}</p><p class="description">{{.ReviewText}}</p><a class="button subtle compact" href="/reviews/{{.ID}}/edit">Edit review</a></div>
</article>{{else}}<p class="empty-state">You haven't written a review yet. Find a movie and share your thoughts.</p>{{end}}</div>
</section>
{{end}}
