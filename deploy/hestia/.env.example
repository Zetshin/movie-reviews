# /opt/movie-reviews/.env on the Hestia server. Keep it chmod 600.

# Image published by the Deploy workflow (deploy.sh updates this line).
APP_IMAGE=ghcr.io/zetshin/movie-reviews:latest

TMDB_API_KEY=

# Existing Hestia database (Hestia prefixes names with the owner, e.g. Arruto_movieclub).
DB_NAME=
DB_USER=
DB_PASSWORD=

# Loopback port that the docker-movieclub proxy template points at.
APP_PORT=4010

# Time zone used to display dates.
TZ=Asia/Bangkok

# Password reset email
PUBLIC_BASE_URL=https://movieclubth.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@movieclubth.com
SMTP_REQUIRE_TLS=true
